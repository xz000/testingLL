#!/bin/sh
# 提交前回归门禁：跑 check.ps1（build + test + clippy -D warnings，三项当前全绿）。
# - 任一检查失败 → 以非零退出，阻止本次提交。
# - 想要临时跳过：  SKIP_HOOKS=1 git commit ...
# - 钩子由 git 调用，工作目录=仓库根（testingLL/）。本项目位于仓库子目录 rust_remake/。
# - 本脚本用 $0 定位自身所在目录，向上取项目根，从而找到 check.ps1（不依赖 show-toplevel，
#   因为仓库根是 testingLL/，而项目在 rust_remake/ 子目录）。

# 逃生阀。
if [ "$SKIP_HOOKS" = "1" ]; then
  echo "[hooks] SKIP_HOOKS=1，跳过提交前检查。"
  exit 0
fi

# 定位钩子所在目录的绝对路径（$0 -> dir -> pwd），项目根为其上一级。
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || script_dir=.
project_root=$(dirname -- "$script_dir") || project_root=.
check_ps1="$project_root/check.ps1"

if [ ! -f "$check_ps1" ]; then
  echo "[hooks] 未找到 check.ps1（在 $check_ps1），放行本次提交。"
  echo "       请确认 check.ps1 与 .githooks 同级（都在 rust_remake/ 下）。"
  exit 0
fi

if ! command -v powershell >/dev/null 2>&1; then
  echo "[hooks] 未找到 PowerShell，放行。（本环境无法自动跑回归。）"
  exit 0
fi

echo "[hooks] 提交前回归检查启动（build + test + clippy -D warnings）..."
powershell -NoProfile -ExecutionPolicy Bypass -File "$check_ps1"
status=$?
if [ $status -ne 0 ]; then
  echo "[hooks] FAIL: 回归检查未通过（退出码 $status）。提交已阻止。"
  echo "        如需强制提交：SKIP_HOOKS=1 git commit ..."
  exit 1
fi
echo "[hooks] OK: 回归通过，继续提交。"
exit 0
